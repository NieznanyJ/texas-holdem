{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node", "@playwright/test"],
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true
    },
    "include": [
        "playwright.config.ts",
        "steps/**/*.ts",
        "fixtures/**/*.ts",
        "pages/**/*.ts",
        "lib/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        ".features-gen",
        "test-results",
        "playwright-report"
    ]
}
